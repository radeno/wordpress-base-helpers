# Static analysis of inc/ against WordPress 7.0 signatures (php-stubs/wordpress-stubs),
# no WordPress install needed.
#
#   composer install            # pulls require-dev (phpstan + stubs)
#   vendor/bin/phpstan analyse --memory-limit=1G
#   composer install --no-dev   # restore the prod-only vendor before committing

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80400
    paths:
        - inc
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        # getAttachmentObject() hands templates a WP_Post with url, human_size and
        # extension added; WP_Post allows dynamic properties.
        -
            identifier: property.notFound
            path: inc/AttachmentHelper.php
        # Offload plugins (e.g. Windows Azure Storage) add 'url' to attachment metadata.
        -
            identifier: isset.offset
            path: inc/RestApiHelper.php
