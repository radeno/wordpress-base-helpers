{
  "name": "radeno/wordpress-base-helpers",
  "version": "1.5.0",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "Radovan Šmitala",
      "homepage": "https://github.com/radeno/wordpress-base-helpers"
    }
  ],
  "license": "MIT",
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true
  },
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "giggsey/libphonenumber-for-php-lite": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "helper\\": "inc/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "~7.0.0",
    "szepeviktor/phpstan-wordpress": "^2.0.4"
  },
  "suggest": {
    "wordpress": "WP 7.0 and higher"
  }
}
